    "codegen": "openapi-typescript \"$NEXT_PUBLIC_API_BASE_URL/openapi.json\" -o src/generated.ts"
  },
  "dependencies": {
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@recomenda/tsconfig": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  }
}
